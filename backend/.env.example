WHATSAPP_NUMBER=918090905900
CORS_ORIGINS=http://localhost:5173
FLASK_DEBUG=false
PORT=5000

# Supabase (Project Settings -> API)
SUPABASE_URL=https://xxxxx.supabase.co
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_ANON_KEY=

# Direct Postgres connection (Project Settings -> Database -> Connection
# string -> URI). Used to apply schema migrations directly.
DATABASE_URL=

# Razorpay (Dashboard -> Settings -> API Keys / Webhooks)
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

# Booking
APPOINTMENT_HOLD_MINUTES=10
CONSULTATION_FEE_INR=500

# Clinic notifications - sent on every successful payment (WhatsApp + Email + SMS)
CLINIC_NOTIFY_PHONE=91XXXXXXXXXX
CLINIC_NOTIFY_EMAIL=clinic@example.com

# Gmail SMTP (Google Account -> Security -> App passwords; needs 2FA enabled)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=

# Twilio (Console -> Account SID / Auth Token; WhatsApp needs a Business-approved
# sender or the Twilio sandbox number for testing)
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_SMS_NUMBER=+1XXXXXXXXXX
TWILIO_WHATSAPP_NUMBER=+1XXXXXXXXXX
TWILIO_VOICE_NUMBER=+1XXXXXXXXXX
# Set to true to also place an automated confirmation call to the patient.
PATIENT_CONFIRMATION_CALL=false
